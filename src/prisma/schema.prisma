generator client {
  provider      = "prisma-client"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guest {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  entries   Int      @default(0)
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
