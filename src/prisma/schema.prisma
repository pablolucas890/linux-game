generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guest {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  entries   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
